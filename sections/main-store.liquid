create_map();
let currentPage = 1;
let lastPage = 1;

function set_stores(page = 1) {
    const storeList = document.getElementById('storeList');
    const paginationDiv = document.getElementById('pagination');

    if (!storeList || !paginationDiv) {
        console.error("Required HTML elements missing: storeList or pagination");
        return;
    }

    storeList.innerHTML = '';
    paginationDiv.innerHTML = '';
    //clearMarkers();

    const elements = document.querySelector(".loader-holder");
    

     if (elements) {
        elements.setAttribute("style","display:flex;");
    }

    fetch(`https://allinone.shopifydevelopmentcompany.com/api/get-initial-stores?page=${page}`)
        .then(response => response.json())
        .then(data => {
          elements.setAttribute("style","display:none;");

            if (!data.success || !Array.isArray(data.locations)) {
                console.error('Invalid response format');
                return;
            }

            currentPage = data.pagination.current_page;
            lastPage = data.pagination.last_page;

            var counter = 0;

            // 1️⃣ Add markers and sidebar stores
            data.locations.forEach(store => {
               const marker = L.marker([store.lat, store.lng]).addTo(map);

let popupHtml = store.popup_html
  .replace(/href="[^"]*"/g, 'href="javascript:void(0)"')
  .replace(/target="[^"]*"/g, '');
                marker.bindPopup(popupHtml);
                
                const div = document.createElement('div');
                div.className = 'store';
                div.innerHTML = `
                    <strong>${store.name}</strong><br>
                    City: ${store.city}<br>
                    Zip: ${store.zip}<br>
                    State: ${getStateName(store.state)}<br>
                    Address: ${store.address}
                `;

                div.addEventListener('click', () => {
                    map.setView([store.lat, store.lng], 14);
                    marker.openPopup();
                });

                storeList.appendChild(div);
                
                if(counter == 0){
                    div.click();
                }
                

                counter++;
            });

            // 2️⃣ Render numeric pagination buttons
            renderPagination();
        })
        .catch(err => console.error('Error:', err));
}
// Render numeric pagination buttons
function renderPagination() {
    const paginationDiv = document.getElementById('pagination');
    if (!paginationDiv) return;
    paginationDiv.innerHTML = '';

    const maxPagesToShow = 5; // current ±2
    const buttons = [];

    let start = Math.max(1, currentPage - 2);
    let end = Math.min(lastPage, currentPage + 2);

    // Always show first page
    if (start > 1) {
        buttons.push(1);
        if (start > 2) buttons.push('...');
    }

    // Current ±2 pages
    for (let i = start; i <= end; i++) buttons.push(i);

    // Always show last page
    if (end < lastPage) {
        if (end < lastPage - 1) buttons.push('...');
        buttons.push(lastPage);
    }

    // Create buttons
    buttons.forEach(p => {
        if (p === '...') {
            const span = document.createElement('span');
            span.textContent = '...';
            span.className = 'dots';
            paginationDiv.appendChild(span);
        } else {
            const btn = document.createElement('button');
            btn.textContent = p;
            btn.className = p === currentPage ? 'active-page' : '';
            btn.addEventListener('click', () => set_stores(p));
            paginationDiv.appendChild(btn);
        }
    });
}

// Optional CSS for active page highlighting
const style = document.createElement('style');
style.innerHTML = `
