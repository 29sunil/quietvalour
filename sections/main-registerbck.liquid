{{ 'customer.css' | asset_url | stylesheet_tag }}

<div
  class="customer register section section--padding"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="section__wrapper">
    <h1 class="text-center">
      {{ 'customer.register.title' | t }}
    </h1>
    {%- form 'create_customer', class: 'flex flex-col' -%}
      {%- if form.errors -%}
        <div class="form-error alert alert--error blocks-radius">
          <h2 class="form-message form-message--error h6 m-0" tabindex="-1" autofocus>
            {% render 'icon-error', size: 'small' %}
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#RegisterForm-{{ field }}">
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      <div class="form-field">
        <label for="RegisterForm-FirstName" class="form-label">
          {{ 'customer.register.first_name' | t }}
        </label>
        <input
          required
          type="text"
          name="customer[first_name]"
          id="RegisterForm-FirstName"
          {% if form.first_name %}
            value="{{ form.first_name }}"
          {% endif %}
          autocomplete="given-name"
          placeholder="{{ 'customer.register.first_name' | t }}"
          class="form-control"
        >
      </div>
      <div class="form-field">
        <label for="RegisterForm-LastName" class="form-label">
          {{ 'customer.register.last_name' | t }}
        </label>
        <input
          required
          type="text"
          name="customer[last_name]"
          id="RegisterForm-LastName"
          {% if form.last_name %}
            value="{{ form.last_name }}"
          {% endif %}
          autocomplete="family-name"
          placeholder="{{ 'customer.register.last_name' | t }}"
          class="form-control"
        >
      </div>
      <div class="form-field">
        <label for="RegisterForm-email" class="form-label">
          {{ 'customer.register.email' | t }}
        </label>
        <input
          required
          type="email"
          name="customer[email]"
          id="RegisterForm-email"
          {% if form.email %}
            value="{{ form.email }}"
          {% endif %}
          spellcheck="false"
          autocapitalize="off"
          autocomplete="email"
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="RegisterForm-email-error"
          {% endif %}
          placeholder="{{ 'customer.register.email' | t }}"
          class="form-control"
        >
        {%- if form.errors contains 'email' -%}
          <span id="RegisterForm-email-error" class="form-message form-message--small form-message--error">
            {% render 'icon-error', size: 'small' %}
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}.
          </span>
        {%- endif -%}
      </div>
      <div class="form-field">
        <label for="RegisterForm-password" class="form-label">
          {{ 'customer.register.password' | t }}
        </label>
        <input
          required
          type="password"
          name="customer[password]"
          id="RegisterForm-password"
          aria-required="true"
          {% if form.errors contains 'password' %}
            aria-invalid="true"
            aria-describedby="RegisterForm-password-error"
          {% endif %}
          placeholder="{{ 'customer.register.password' | t }}"
          class="form-control"
        >
        {%- if form.errors contains 'password' -%}
          <span id="RegisterForm-password-error" class="form-message form-message--small form-message--error">
            {% render 'icon-error', size: 'small' %}
            {{ form.errors.translated_fields.password | capitalize }}
            {{ form.errors.messages.password }}.
          </span>
        {%- endif -%}
      </div>

      <div class="form-field">
        <label for="RegisterForm-confirm-password" class="form-label"> Confirm Password </label>
        <input
          required
          type="password"
          id="RegisterForm-confirm-password"
          aria-required="true"
          placeholder="Confirm Password"
          class="form-control"
          name=""
        >

        <span
          id="RegisterForm-confirm-password-error"
          class="form-message form-message--small form-message--error"
          style="display:none;"
        >
          confirm Passwords do not match.
        </span>
      </div>

      <div class="form-field">
        <input
          type="checkbox"
          id="is_subscribed"
          name="customer[is_subscribed]"
          value="true"
          class="checkbox"
        >
        <label for="is_subscribed" class="label">
          <span>Sign Up for Newsletter</span>
        </label>
      </div>
      <div class="form-field">
        <input
          type="checkbox"
          id="assistance_allowed"
          name="customer[assistance_allowed]"
          value="true"
          class="checkbox"
        >
        <label for="assistance_allowed" class="label">
          <span>Allow remote shopping assistance</span>
        </label>

        
      </div>

      <div class="form-field">
        <label for="RegisterForm-certified-tech" class="form-label"> Name of Certified Technician </label>
        <input
          required
          type="text"
          id="RegisterForm-certified-tech"
          aria-required="true"
          placeholder="Name of Certified Technician"
          class="form-control"
          name="customer[certified-tech]"
        >
      </div>
      <div class="form-field">
        <label for="RegisterForm-licence-id" class="form-label"> Certified Technician's License ID </label>
        <input
          required
          type="file"
          id="RegisterForm-licence-id"
          aria-required="true"
          placeholder="Certified Technician's License ID"
          class="form-control"
          name="customer[licence-id]"
        >
      </div>
      <div class="form-field">
        <label class="form-label">Refrigerant Reseller</label>
        <div>
          <input
            type="radio"
            id="reseller-no"
            name="customer[refrigerant_reseller]"
            value="No"
          >
          <label for="reseller-no">No</label>
        </div>
        <div>
          <input
            type="radio"
            id="reseller-yes"
            name="customer[refrigerant_reseller]"
            value="Yes"
            required
          >
          <label for="reseller-yes">Yes</label>
        </div>
      </div>

      <div class="form-field">
        <label for="license_applied" class="form-label"> Technician License Applied </label>

        <select
          id="license_applied"
          name="customer[license_applied]"
          class="form-control"
          required
        >
          <option value="">Select option</option>
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </select>
      </div>
      <div class="form-field">
        <label for="license_approved" class="form-label"> Technician License Approved </label>

        <select
          id="license_approved"
          name="customer[license_approved]"
          class="form-control"
          required
        >
          <option value="">Select option</option>
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </select>
      </div>
      <div class="form-field">
        <label for="RegisterForm-license-file" class="form-label"> Technician License File </label>
        <input
          required
          type="text"
          id="RegisterForm-license-file"
          aria-required="true"
          placeholder="Technician License File"
          class="form-control"
          name="customer[license-file]"
        >
      </div>
      <div class="form-field">
        <label for="RegisterForm-license-number" class="form-label"> Technician License Number </label>
        <input
          required
          type="text"
          id="RegisterForm-license-number"
          aria-required="true"
          placeholder="Technician License Number"
          class="form-control"
          name="customer[license-number]"
        >
      </div>

      <button class="btn btn--primary w-full">
        {{ 'customer.register.submit' | t }}
      </button>
      <a href="{{ routes.account_login_url }}" class="btn btn--underline self-center">
        {{ 'customer.login_page.sign_in' | t }}
      </a>
    {%- endform -%}
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

  const form = document.querySelector('form[action*="/account"]');
  const password = document.getElementById('RegisterForm-password');
  const confirmPassword = document.getElementById('RegisterForm-confirm-password');
  const errorMessage = document.getElementById('RegisterForm-confirm-password-error');

  // When submitting
  form.addEventListener('submit', function (e) {

    if (password.value !== confirmPassword.value) {
      e.preventDefault();
      e.stopImmediatePropagation();
      errorMessage.style.display = 'block';
      confirmPassword.setAttribute('aria-invalid', 'true');
      return false;
    }

    // Save data temporarily before redirect
    const data = {
      technician_name: document.getElementById('certified_technician_name').value,
      license_number: document.getElementById('RegisterForm-license-number').value,
      license_applied: document.getElementById('license_applied').value,
      license_approved: document.getElementById('license_approved').value,
      refrigerant_reseller: document.querySelector('input[name="refrigerant_reseller"]:checked')?.value || ''
    };

    sessionStorage.setItem('metaData', JSON.stringify(data));
  });

  // AFTER page reload (customer logged in)
  const savedData = sessionStorage.getItem('metaData');

  if (savedData) {
    sessionStorage.removeItem('metaData');

    const formData = new FormData();
    const parsed = JSON.parse(savedData);

    for (let key in parsed) {
      formData.append(key, parsed[key]);
    }

    fetch(`https://allinone.shopifydevelopmentcompany.com/api/get-initial-stores?page=${page}`)

    fetch('/customer-meta', {
      method: 'POST',
      body: formData
    }).then(res => res.text())
      .then(data => console.log('Meta saved:', data));
  }

});
</script>



{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 100
    }
  ]
}
{% endschema %}
