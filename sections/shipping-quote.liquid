{% if cart.item_count > 0 %}

<div class="quote-layout">

  <div class="left-cart">

    <h2>Your Cart</h2>

    {% for item in cart.items %}

      <div class="cart-row">

        <img src="{{ item.image | image_url: width:120 }}">

        <div class="cart-info">

          <h4>{{ item.product.title }}</h4>

          <div class="cart-meta">
            <span>Qty: {{ item.quantity }}</span>
            <span>{{ item.final_line_price | money }}</span>
          </div>

        </div>

      </div>

    {% endfor %}

    <div class="quote-total">
      Total: {{ cart.total_price | money }}
    </div>

  </div>

  <div class="right-form">

    <div class="quote-card">

      <h2>Get Shipping Quote</h2>

      <!-- YOUR FORM HERE -->
<form action="javascript:void(0)" id="ShippingQuoteForm" method="post">
    <div class="shipping-field"> <label>Your name</label> <input class="shipping-quote-required" type="text"
            name="your_name"> </div>
    <div class="shipping-field"> <label>Your email</label> <input class="shipping-quote-required" type="email"
            name="your_email"> </div>
    <div class="shipping-field"> <label>Your phone</label> <input type="tel" name="your_phone"> </div>
    <div class="shipping-field"> <label>Your shipping address</label> <textarea class="shipping-quote-required" name="message"></textarea> </div>
    <div class="shipping-field"> <button type="submit" class="shipping-quote-submit"> Request Shipping Quote </button>
        <span id="quote-success" style="color:green;display:none;"></span> <span class="quote-error"
            style="color:red;display:none;"></span>
    </div>
</form> <button class="change-cart"> Change Cart Items </button>
    </div>

  </div>

</div>

{% else %}

<div class="empty-cart-box">

    <h2>Your Cart is Empty</h2>

    <p>
        Add products to your cart before requesting
        a shipping quote.
    </p>

    <a href="/collections/all" class="continue-shopping-btn">
        Continue Shopping
    </a>

</div>

{% endif %}
<script>
const form = document.getElementById('ShippingQuoteForm');

if (form) {

form.addEventListener('submit', async function(e){

    e.preventDefault();

    let valid = true;

    const successMessageContainer =
        document.getElementById("quote-success");

    const errorMessageContainer =
        document.querySelector(".quote-error");

    form.querySelectorAll('.error')
        .forEach(el => el.remove());

    form.querySelectorAll('input,textarea')
        .forEach(input => {
            input.classList.remove('input-error');
        });

    successMessageContainer.innerHTML='';

    form.querySelectorAll('.shipping-quote-required')
    .forEach(function(input){

        if(input.disabled) return;

          
        const value = input.value.trim();

        if(!value){

            input.classList.add('input-error');

            const error=document.createElement('span');

            error.className='error';
            error.style.color='red';
            error.textContent='This is a required field';

            input.insertAdjacentElement(
                'afterend',
                error
            );

            valid=false;
        }

    });

    /* EMAIL VALIDATION */

    const email_element =
        form.querySelector(
            'input[name="your_email"]'
        );

    const email =
        email_element ?
        email_element.value.trim() : '';

    const emailRegex =
        /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if(email && !emailRegex.test(email)){

        email_element.classList.add(
            'input-error'
        );

        const error=document.createElement('span');

        error.className='error';
        error.style.color='red';
        error.textContent='Invalid email';

        email_element.insertAdjacentElement(
            'afterend',
            error
        );

        valid=false;
    }

    /* PHONE VALIDATION */

    const phone_element =
        form.querySelector(
            'input[name="your_phone"]'
        );

    const phone =
        phone_element ?
        phone_element.value.trim() : '';

    const phoneRegex =
        /^(\+1\s?)?(\(\d{3}\)|\d{3})[\s.-]?\d{3}[\s.-]?\d{4}$/;

    if(phone && !phoneRegex.test(phone)){

        phone_element.classList.add(
            'input-error'
        );

        const error=document.createElement('span');

        error.className='error';
        error.style.color='red';
        error.textContent='Invalid phone number';

        phone_element.insertAdjacentElement(
            'afterend',
            error
        );

        valid=false;
    }

    if(!valid) return;

    const submitBtn =
        document.querySelector(
            '.shipping-quote-submit'
        );

    submitBtn.innerText='Please wait...';
    submitBtn.disabled=true;

    try{

        const formData =
            new FormData(this);

        const cart =
            await fetch('/cart.js')
            .then(r=>r.json());

        formData.append(
            'products',
            JSON.stringify(cart.items)
        );

        const response =
            await fetch(
            'https://allinone.shopifydevelopmentcompany.com/api/submit-shipping-quote',
            {
                method:'POST',
                body:formData
            });

        const result =
            await response.json();

            console.log(result, " : result");

        if(result.success == true){

 // Shopify cart clear
            fetch('/cart/clear.js', { method: 'POST' })
            .then(res => res.json())
            .then(() => {
                 successMessageContainer.innerHTML =
                result.message;

            successMessageContainer.style.display =
                'block';
            form.reset();
            window.location.href = '/';

            });
           

       

        }

    }catch(err){

        console.error(err);

        errorMessageContainer.innerHTML =
            'Something went wrong';

        errorMessageContainer.style.display =
            'block';
    }

    submitBtn.disabled=false;
    submitBtn.innerText=
        'Request Shipping Quote';

});

}

/* CHANGE CART BUTTON */

const changeCartBtn =
    document.querySelector('.change-cart');

if(changeCartBtn){

changeCartBtn.addEventListener(
'click',
function(){

    window.location.href='/cart';

});

}
</script>